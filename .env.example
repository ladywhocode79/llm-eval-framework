# ── LLM App (the system under test) ──────────────────────────────
# Required: Claude API key for the QA pipeline
ANTHROPIC_API_KEY=your-api-key-here

# ── LLM Judge (the evaluator) ─────────────────────────────────────
# JUDGE_BACKEND controls which model grades the LLM outputs.
#
#   ollama  → local model via Ollama (default, free, no internet needed)
#   openai  → OpenAI via deepeval default (requires OPENAI_API_KEY)
#
JUDGE_BACKEND=ollama

# Ollama model to use as judge (only applies when JUDGE_BACKEND=ollama)
# Pull a model first:  ollama pull llama3.2
# Options (ordered by speed vs quality):
#   llama3.2      — recommended: fast, ~2 GB, good quality
#   llama3.2:1b   — fastest, ~1 GB, lower quality
#   mistral       — higher quality, ~4 GB, slower
#   phi3:mini     — good balance, ~2.3 GB
OLLAMA_MODEL=llama3.2

# Required only when JUDGE_BACKEND=openai
# OPENAI_API_KEY=your-openai-key-here

# ── LLM Judge for evals/tests/test_evals.py (model-agnostic) ──────
# EVAL_JUDGE_BACKEND controls the judge used ONLY by test_evals.py.
# Falls back to JUDGE_BACKEND above if unset, so JUDGE_BACKEND=ollama keeps
# working as-is. Set this instead of JUDGE_BACKEND if you want test_evals.py
# to use a different backend than the other eval files (e.g. gemini/anthropic
# here while test_answer_relevancy.py/test_faithfulness.py stay on ollama).
#
#   auto      → (default) prefer local Ollama when it's running and the
#                model is pulled; else fall back to GEMINI_API_KEY, then
#                ANTHROPIC_API_KEY, whichever is set below
#   ollama    → force local Ollama (uses OLLAMA_MODEL above)
#   gemini    → force Gemini (requires GEMINI_API_KEY)
#   anthropic → force Claude (requires ANTHROPIC_API_KEY above)
#
# EVAL_JUDGE_BACKEND=auto

# Required only when EVAL_JUDGE_BACKEND resolves to gemini
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Optional override when EVAL_JUDGE_BACKEND resolves to anthropic
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
